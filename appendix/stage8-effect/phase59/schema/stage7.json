  "environment": "開発環境はPython 3.13とFastAPIによるバックエンド、Next.js(App Router)とTamaguiによるフロントエンドをDocker Composeで統合する。データベースにはPostgreSQLを使用し、キャッシュとレート制限にはRedisを利用する。CI/CDパイプラインとしてGitHub Actionsを用い、mainブランチへのpush時にVPS上のDocker Compose環境へ自動デプロイする構成とする。",
  "crosscutting": [
    {
      "topic": "例外と HTTP",
      "policy": "発生した例外は app/main.py の例外変換機構ですべて捕捉し、ValidationError は 400 Bad Request、AuthenticationError や UnauthorizedError は 401 Unauthorized、NotFoundError は 404 Not Found、ConflictError は 409 Conflict、その他の予期せぬ例外は 500 Internal Server Error にマッピングしてクライアントへ返却する。AIの応答に失敗した場合は 500 としメッセージを保存しない。",
      "modules": [
        "app/main.py",
        "app/services/auth.py",
        "app/services/chat.py",
        "app/services/generation.py"
      ],
      "req_ids": [
        "FR-010"
      ]
    },
    {
      "topic": "認証",
      "policy": "JWTを用いた認証を実装し、アクセストークンの有効期限は30分、リフレッシュトークンの有効期限は14日とする。リフレッシュトークンはHttpOnly Cookieに設定し、ログアウト時やリフレッシュ時にRedisを用いてトークンの失効管理およびトークンローテーションを行う。",
      "modules": [
        "app/api/routes/auth.py",
        "app/services/auth.py",
        "app/repositories/auth.py",
        "app/cache/redis.py"
      ],
      "req_ids": [
        "FR-002",
        "FR-012"
      ]
    },
    {
      "topic": "トランザクション",
      "policy": "複数のテーブル更新や外部連携を伴う一連のデータ操作(ユーザー登録、ログイン、プロジェクト作成、チャットメッセージ送信など)は、サービス層から呼び出される永続化処理の範囲で単一のトランザクションとして扱い、エラー発生時はロールバックする。読み取り専用の処理や非同期のバッチジョブ開始については個別に処理する。",
      "modules": [
        "app/services/auth.py",
        "app/services/project.py",
        "app/services/chat.py",
        "app/services/generation.py",
        "app/repositories/auth.py",
        "app/repositories/project.py",
        "app/repositories/chat.py",
        "app/repositories/job.py"
      ],
      "req_ids": []
    },
    {
      "topic": "ログ",
      "policy": "セキュリティ上の理由から、ユーザーが入力した対話内容や機密情報はアプリケーションログに残さないものとする。ログにはエラーの有無、処理時刻、およびトラブルシューティングに必要なシステム状態のみを出力する。",
      "modules": [
        "app/main.py",
        "app/api/routes/chat.py",
        "app/ai/agent.py"
      ],
      "req_ids": [
        "NFR-006"
      ]
    },
    {
      "topic": "レート制限",
      "policy": "ログインの総当たり攻撃や登録の大量作成、およびチャットや設計書生成の不正利用を防ぐため、Redisを用いたレート制限を適用し、制限超過時は Retry-After ヘルパーを含む 429 Too Many Requests を返却する。(要決定: 制限回数やウィンドウ期間)",
      "modules": [
        "app/cache/redis.py",
        "app/api/routes/auth.py",
        "app/api/routes/chat.py",
        "app/api/routes/generation.py"
      ],
      "req_ids": [
        "FR-011"
      ]
    },
    {
      "topic": "非同期処理",
      "policy": "4種の設計書一括生成およびAI自己診断の処理は時間がかかるため、FastAPIのバックグラウンドタスクまたは非同期ジョブ機構を用いてバックグラウンドで実行し、クライアントへは即座にジョブIDを返却してポーリング等による進捗確認を行う。",
      "modules": [
        "app/services/generation.py",
        "app/repositories/job.py",
        "app/ai/agent.py",
        "app/api/routes/generation.py"
      ],
      "req_ids": [
