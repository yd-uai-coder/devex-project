 + Tamagui (フロントエンド)、FastAPI + LangChain・LangGraph Python 3.13 (バックエンド)、PostgreSQLとRedis (データベース)、Gemini Flash-Lite API (LLM) を選定し、VPS環境にてDocker Composeとnginxで構成・運用します。", "error_policy": "FastAPIの例外ハンドラーを用いて共通のエラーレスポンス形式（JSON形式のステータスコード・エラーコード・メッセージ）を返却します。例外発生時は機密情報や入力内容を一切ログに残さず、エラーの有無や日時、エラー種別のみを記録します。", "external_apis": ["POST /api/v1/auth/register", "POST /api/v1/auth/login", "POST /api/v1/projects", "POST /api/v1/chat/messages", "POST /api/v1/documents/generate"], "module_policy": "FastAPIのレイヤードアーキテクチャに基づき、ルーティング層(backend/api/v1/)、ビジネスロジック・サービス層(backend/services/)、セキュリティ・DB接続の共通基盤層(backend/core/)に分割して配置します。\n\n```text\nbackend/\n├── main.py\n├── api/v1/\n│   ├── auth.py\n│   ├── projects.py\n│   ├── chat.py\n│   └── documents.py\n├── services/\n│   ├── ai_service.py\n│   └── chat_graph.py\n└── core/\n    ├── security.py\n    └── database.py\n```", "data_model_note": "主要エンティティとして users (ユーザー), projects (プロジェクト), chat_messages (チャットメッセージ), documents (設計書), diagnostics (自己診断) を定義し、ORMを通じてPostgreSQLでリレーショナルに管理します。", "next_dataflow_seq": 6}, "requirements" : {"rows": [{"id": "FR-001", "kind": "FR", "text": "誰でも登録できるサービスとしてユーザー登録とログイン機能を提供する", "points": ["scale", "security"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-002", "kind": "FR", "text": "メールとパスワードによるJWT認証を行い、アクセストークンは30分、リフレッシュトークンは14日でHttpOnly Cookieに保存する", "points": ["security"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-003", "kind": "FR", "text": "参考資料(txt、md、pdf、最大5件)を初期入力で読み込めるようにする", "points": ["core"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-004", "kind": "FR", "text": "チャットでのヒアリングに基づく「要件定義」「外部設計」「内部設計」「実装計画」の4種の Markdown 設計書を一括生成する", "points": ["core"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-005", "kind": "FR", "text": "生成後に AI が各文書の不足点を3段階(最重要/中程度/軽微)で自己診断して提示する", "points": ["core"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-006", "kind": "FR", "text": "生成した Markdown をプレビュー、コピー、ダウンロードできる", "points": ["core"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-007", "kind": "FR", "text": "AIの応答失敗時はメッセージを保存せずに再送を促し、生成失敗時は再生成できるようにする", "points": ["exceptions"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-008", "kind": "FR", "text": "チャットの1回の入力は数千文字までとし、空の送信を禁止する", "points": ["exceptions"], "source": "user", "category": "", "priority": "Must"}, {"id": "FR-009", "kind": "FR", "text": "テンプレートの選択、版の履歴の画面、設計図(UML)の追加を将来的に拡張する", "points": ["future"], "source": "user", "category": "", "priority": "Could"}, {"id": "NFR-001", "kind": "NFR", "text": "止まっても半日なら問題なく、夜間の保守による停止を許容する", "points": ["availability"], "source": "user", "category": "可用性", "priority": null}, {"id": "NFR-002", "kind": "NFR", "text": "DBを毎日バックアップして7日分を残し、VPSの外にもコピーする", "points": ["backup"], "source": "user", "category": "可用性", "priority": null}, {"id": "NFR-003", "kind": "NFR", "text": "同時に数人〜十数人が利用し、チャットの最初の文字が数秒、4文書の生成は数分までの待機を許容する", "points": ["performance"], "source": "user", "category": "性能・拡張性", "priority": null}, {"id": "NFR-004", "kind": "NFR", "text": "エラーの追跡と死活監視はMVPの後で実施する", "points": ["operability"], "source": "adopted", "category": "運用・保守性", "priority": null}, {"id": "NFR-005", "kind": "NFR", "text": "移行するデータや仕組みは無い", "points": ["migration"], "source": "adopted", "category": "移行性", "priority": null}, {"id": "NFR-006", "kind": "NFR", "text": "機密性保持のため他人のプロジェクト閲覧を不可とする", "points": ["security"], "source": "user", "category": "セキュリティ", "priority": null}, {"id": "NFR-007", "kind": "NFR", "text": "機密情報や入力内容は一切ログに残さず、エラーの有無や日時だけを残す", "points": ["logging"], "source": "adopted", "category": "セキュリティ", "priority": null}, {"id": "NFR-008", "kind": "NFR", "text": "ログインの総当たり、登録の大量作成、チャットと生成の回数制限により不正利用を防ぐ", "points": ["abuse"], "source": "user", "category": "セキュリティ", "priority": null}, {"id": "NFR-009", "kind": "NFR", "text": "PCの最新のChrome・Edge・Firefox・Safariで利用し、スマホは閲覧のみ対応とする", "points": ["environment"], "source": "user", "category": "システム環境・エコロジー", "priority": null}, {"id": "CON-001", "kind": "CON", "text": "フロントエンドはNext.js(App Router)+ Tamaguiを採用する", "points": ["tech"], "source": "user", "category": "技術スタック", "priority": null}, {"id": "CON-002", "kind": "CON", "text": "バックエンドはFastAPI + LangChain・LangGraph(Python 3.13)を採用する", "points": ["tech"], "source": "user", "category": "技術スタック", "priority": null}, {"id": "CON-003", "kind": "CON", "text": "データベースはPostgreSQL、Redis(レート制限・トークン失効)を採用する", "points": ["tech"], "source": "user", "category": "技術スタック", "priority": null}, {"id": "CON-004", "kind": "CON", "text": "LLMにはGemini Flash-Liteを使用する", "points": ["tech"], "source": "user", "category": "外部サービス", "priority": null}, {"id": "CON-005", "kind": "CON", "text": "VPSにDocker Composeとnginxで配置し、GitHub Actionsでmainへのpushから自動デプロイする", "points": ["tech"], "source": "user", "category": "配置", "priority": null}], "scale": "public", "users": [{"user": "SE・ITコンサルタント・PM、個人開発者・スタートアップの創業者", "scene": "新規プロジェクトの立ち上げ時やクライアントとの打ち合わせ後にヒアリングを行い、その日のうちに生成されたドラフトを見直して共有する", "source": "user"}], "purpose": "システム開発の初期フェーズにおけるドキュメント作成の工数削減と属人化の防止", "in_scope": ["チャットでのヒアリングに基づく4種設計書の一括生成(参考資料の上限5件)", "自己診断提示", "プレビュー・コピー・ダウンロード", "参考資料読み込み", "PostgreSQLへのデータ保存", "誰でも登録できるサービスとしてのユーザー登録とログイン機能"], "next_seq": {"FR": 10, "CON": 6, "NFR": 10}, "out_of_scope": ["コードの自動生成", "Jira・Notion連携", "マルチテナントの権限管理", "音声入力", "複数人の同時編集", "プロジェクトの削除やアカウントの退会機能"], "point_statuses": {"core": "decided", "tech": "decided", "abuse": "decided", "scale": "adopted", "scope": "decided", "users": "decided", "backup": "decided", "future": "decided", "logging": "adopted", "purpose": "decided", "schedule": "open", "security": "decided", "migration": "adopted", "daily_flow": "decided", "exceptions": "decided", "environment": "decided", "operability": "adopted", "performance": "decided", "availability": "decided", "data_retention": "decided"}} }
