      }
    ],
    "in_scope": [
      "チャットヒアリング",
      "完了後の構造化サマリ確認",
      "逐次生成",
      "版管理",
      "参考資料のテキスト化と保持",
      "ログイン機能",
      "設計書の自己診断",
      "プレビュー・コピー・ダウンロード機能"
    ],
    "out_of_scope": [
      "コードの自動生成",
      "Jira・Notion連携",
