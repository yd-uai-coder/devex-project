    "rows": [
      {
        "id": "FR-001",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "チャット機能によりAIが1つずつ質問して深掘りするヒアリングを行う",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-002",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "ヒアリング完了後に構造化サマリを提示し、ユーザーが承認してから生成する",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-003",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "要件定義・外部設計・内部設計・実装計画の4種の設計書を逐次で生成する",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-004",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "生成後にAIが各文書の不足点を3段階で自己診断して提示する",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-005",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "生成したMarkdownをプレビュー・コピー・ダウンロードできる",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-006",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "参考資料(txt/md/pdf、最大3件)を読み込み、テキストをDBに保存して対話のコンテキストに含める",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-007",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "ログイン機能を実装する",
        "source": "adopted",
        "points": [
          "security"
        ]
      },
      {
        "id": "FR-008",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "文書ごとに版を増やして直近3件を保持し、チャットで追加の回答をして再生成できる",
        "source": "user",
        "points": [
          "core"
        ]
      },
      {
        "id": "FR-009",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "AIの応答失敗時は理由を表示してメッセージを送らずに再送を促し、生成失敗時は再生成できるようにする",
        "source": "user",
        "points": [
          "exceptions"
        ]
      },
      {
        "id": "FR-010",
        "kind": "FR",
        "priority": "Must",
        "category": "",
        "text": "チャットは数千文字までとし、空送信は不可とする",
        "source": "user",
        "points": [
          "exceptions"
        ]
      },
      {
        "id": "FR-011",
        "kind": "FR",
        "priority": "Should",
        "category": "",
        "text": "テンプレートの選択、版の履歴の画面、設計図(UML)の追加を行う",
