            "constraints": "NOT NULL",
            "description": "パスワードハッシュ"
          },
          {
            "name": "created_at",
            "type": "TIMESTAMP",
            "constraints": "NOT NULL",
            "description": "作成日時"
          }
        ]
      },
      {
        "name": "projects",
        "description": "",
        "columns": [
          {
            "name": "id",
            "type": "UUID",
            "constraints": "PK",
            "description": "プロジェクトID"
          },
          {
            "name": "user_id",
